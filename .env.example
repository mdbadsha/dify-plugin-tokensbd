# Remote debugging (docs: develop-plugin/features-and-specs/plugin-types/remote-debug-a-plugin).
# Copy to .env and fill in from Dify: Plugins > the debug icon (Host Address and API Key).
INSTALL_METHOD=remote
REMOTE_INSTALL_URL=debug.dify.ai:5003
REMOTE_INSTALL_KEY=********-****-****-****-************
